                <div class="stat-box tc-tooltip" data-desc="${coreRules.peso}"><span class="stat-lbl">PESO</span><span class="stat-val" id="peso-max-${uid}">${p.equipamento_loadout || 0}/${p.loadout_max}</span></div>
