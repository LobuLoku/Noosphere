const passiveHtml = renderAbilities(omitEliteMirrorList(p.habilidades_passivas), passiveMap, "Passiva", "#00bfff");

// ArrayBuffer to Base64 Helper
function bufferToBase64(buf) {
    var binStr = '';
    var bytes = new Uint8Array(buf);
    var len = bytes.byteLength;
    for (var i = 0; i < len; i++) {
        binStr += String.fromCharCode(bytes[i]);
    }
    return window.btoa(binStr);
}

// IMAGEM E DATA
let imgURL = "";
