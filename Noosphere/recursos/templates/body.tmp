        if (apMatch) {
            apCost = `<span style="margin-left: 5px; font-size: 0.78rem; letter-spacing: 1px;">${apMatch[1]}</span>`;
            cleanDesc = desc.substring(apMatch[0].length);
        }
        return `<div style="margin-bottom: 3px; font-family: sans-serif; font-size: 0.82rem; line-height: 1.35; background: transparent; padding: 2px 8px; border-left: 3px solid ${color}; break-inside: avoid; page-break-inside: avoid;">
            <strong style="color: ${color}; text-transform: uppercase; font-size: 0.88rem;">${item}${apCost}:</strong> 
            <span style="color: #ccc;">${cleanDesc}</span>
        </div>`;
    }).join('');
};

const renderPadrao = (listRaw, map, color) => {
