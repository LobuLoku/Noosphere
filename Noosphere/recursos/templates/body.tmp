(function rykeWeaponAbilityBootstrap() {
    if (window.__rykeWeaponAbilBlocks) return;
    window.__rykeWeaponAbilBlocks = true;

    function getWeapons(root) {
        var weapons = [];
        var jel = root.querySelector(".js-weapons-json");
        if (jel && jel.textContent) { try { weapons = JSON.parse(jel.textContent); } catch (e) {} }
        if (!weapons.length) { try { weapons = JSON.parse(decodeURIComponent(root.getAttribute("data-weapons") || "%5B%5D")); } catch (e2) {} }
        return weapons;
    }
    function getMaps(root) {
        try { return JSON.parse(decodeURIComponent(root.getAttribute("data-maps") || "%7B%7D")); } catch (e) { return {}; }
    }
    function findWeapon(weapons, name) {
        if (!name || name === "__none__") return null;
        for (var i = 0; i < weapons.length; i++) { if (weapons[i] && String(weapons[i].name) === name) return weapons[i]; }
        return null;
    }
    function abilBlocks(list, map, color) {
        if (!list || !list.length) return "";
        var html = "";
        for (var j = 0; j < list.length; j++) {
            var item = String(list[j] || "").trim();
            if (!item) continue;
            var k = item.toLowerCase();
            var desc = (map && map[k]) || "DescriÃ§Ã£o nÃ£o encontrada no glossÃ¡rio.";
            var apCost = "", cleanDesc = desc;
            var apMatch = cleanDesc.match(/^\[([ðŸ”´]+)\]\s*/);
            if (apMatch) { apCost = '<span style="margin-left:4px;font-size:0.68rem;letter-spacing:1px;">' + apMatch[1] + "</span>"; cleanDesc = cleanDesc.substring(apMatch[0].length); }
            html += '<div style="margin-bottom:4px;font-family:sans-serif;font-size:0.72rem;line-height:1.3;padding:2px 6px;border-left:3px solid ' + color + ';break-inside:avoid;page-break-inside:avoid">';
            html += '<strong style="color:' + color + ';text-transform:uppercase;font-size:0.74rem;">' + item + apCost + ":</strong> ";
            html += '<span style="color:#ccc;">' + cleanDesc + "</span></div>";
        }
        return html;
    }

    function utilityPassivaOrAcaoBlocks(list, passiveMap, activeMap, color) {
        if (!list || !list.length) return "";
        passiveMap = passiveMap || {};
        activeMap = activeMap || {};
        var html = "";
        for (var j = 0; j < list.length; j++) {
            var item = String(list[j] || "").trim();
            if (!item) continue;
            var k = item.toLowerCase();
            var inPass = passiveMap[k];
            var inAct = activeMap[k];
            var desc = inPass || inAct || "Descrição não encontrada no glossário.";
            var isActGrant = !!inAct && !inPass;
            var label = isActGrant ? ("GANHE A AÇÃO: " + item) : item;
            var apCost = "", cleanDesc = desc;
            var apMatch = cleanDesc.match(/^\[([ðŸ"´]+)\]\s*/);
            if (apMatch) { apCost = '<span style="margin-left:4px;font-size:0.68rem;letter-spacing:1px;">' + apMatch[1] + "</span>"; cleanDesc = cleanDesc.substring(apMatch[0].length); }
            html += '<div style="margin-bottom:4px;font-family:sans-serif;font-size:0.72rem;line-height:1.3;padding:2px 6px;border-left:3px solid ' + color + ';break-inside:avoid;page-break-inside:avoid">';
            html += '<strong style="color:' + color + ';text-transform:uppercase;font-size:0.74rem;">' + label + apCost + ":</strong> ";
            html += '<span style="color:#ccc;">' + cleanDesc + "</span></div>";
        }
        return html;
    }

    /** Update one utility slot (suffix = "A" or "B") */
    function updateSlot(root, suffix, weaponName) {
        var uid = root.id;
        if (!uid) return;
        var weapons = getWeapons(root);
        var maps = getMaps(root);
        var wMap = maps.weapon || maps.passive || {};
        var uMap = maps.utilityPassive || maps.passive || {};
        var isNone = (weaponName === "__none__");
        var w = isNone ? null : findWeapon(weapons, weaponName);
        var s = suffix; // "A" or "B"

        var disp = document.getElementById("w-sel-display-" + s + "-" + uid);
        var statsGrid = document.getElementById("w-stats-grid-" + s + "-" + uid);
        var pesoEl = document.getElementById("w-peso-" + s + "-" + uid);
        var pmEl = document.getElementById("w-pts-mod-" + s + "-" + uid);
        var kwsEl = document.getElementById("w-kws-" + s + "-" + uid);
        var tagsEl = document.getElementById("w-tags-" + s + "-" + uid);
        var pasEl = document.getElementById("w-passives-" + s + "-" + uid);
        var atkEl = document.getElementById("w-atk-" + s + "-" + uid);
        var miraEl = document.getElementById("w-mira-" + s + "-" + uid);
        var distEl = document.getElementById("w-dist-" + s + "-" + uid);
        var dmgEl = document.getElementById("w-dmg-" + s + "-" + uid);

        function txt(v) { return v == null ? "" : String(v); }
        function nz(v, d) { var x = txt(v); return x.length ? x : d; }

        if (disp) disp.textContent = isNone ? "SEM LOADOUT" : (weaponName || "â€” ESCOLHA â€”");
        if (statsGrid) statsGrid.style.display = (w && w.tipo !== "Utility") ? "grid" : "none";
        if (atkEl) atkEl.textContent = w ? nz(w.ataques, "0") : "0";
        if (miraEl) miraEl.textContent = w ? nz(w.mira, "0") : "0";
        if (distEl) distEl.textContent = w && txt(w.distancia).length ? txt(w.distancia) : "-";
        if (dmgEl) dmgEl.textContent = w && txt(w.dano).length ? txt(w.dano) : "-";
        if (pesoEl) pesoEl.textContent = isNone ? "0" : (w && txt(w.peso).length ? txt(w.peso) : "0");
        if (pmEl) {
            var pm = w && w.point_mod, pn = parseInt(pm, 10), showPm = !isNone && pm != null && pm !== "" && !isNaN(pn);
            if (showPm) { pmEl.classList.add("is-visible"); pmEl.textContent = (pn > 0 ? "+" : "") + pn + " PTS"; }
            else { pmEl.classList.remove("is-visible"); pmEl.textContent = ""; }
        }
        if (kwsEl) {
            if (!w || !w.keywords || !w.keywords.length) kwsEl.innerHTML = "";
            else kwsEl.innerHTML = w.keywords.map(function(k) {
                return '<span style="font-size:0.5rem;text-transform:uppercase;color:#80e5ff;border:1px solid rgba(0,217,255,0.35);padding:1px 5px;border-radius:10px;">' + txt(k).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;") + "</span>";
            }).join(" ");
        }
        if (tagsEl) tagsEl.innerHTML = w && w.caracteristicas ? abilBlocks(w.caracteristicas, wMap, "#00ffff") : "";
        if (pasEl) pasEl.innerHTML = w && w.passivas_de_utility ? utilityPassivaOrAcaoBlocks(w.passivas_de_utility, uMap, maps.active || {}, "#00bfff") : "";
    }

    /** Sync selectors so both slots can't pick the same weapon */
    function syncSelectors(root) {
        var selA = root.querySelector(".js-weapon-sel-A");
        var selB = root.querySelector(".js-weapon-sel-B");
        if (!selA || !selB) return;
        var valA = selA.value, valB = selB.value;
        // Re-enable all options first
        [selA, selB].forEach(function(sel) {
            for (var i = 0; i < sel.options.length; i++) sel.options[i].disabled = false;
        });
        // Disable the other slot's choice (skip "" and "__none__")
        if (valA && valA !== "__none__") {
            for (var i = 0; i < selB.options.length; i++) { if (selB.options[i].value === valA) selB.options[i].disabled = true; }
        }
        if (valB && valB !== "__none__") {
            for (var i = 0; i < selA.options.length; i++) { if (selA.options[i].value === valB) selA.options[i].disabled = true; }
        }
    }

    var prevInit = window.initUnitDashboard;
    window.initUnitDashboard = function (root) {
        if (typeof prevInit === "function") prevInit(root);
        // Initialize both slots
        var selA = root.querySelector(".js-weapon-sel-A");
        var selB = root.querySelector(".js-weapon-sel-B");
        if (selA) updateSlot(root, "A", selA.value);
        if (selB) updateSlot(root, "B", selB.value);
        syncSelectors(root);
    };

    document.addEventListener("change", function (ev) {
        var t = ev.target;
        if (!t) return;
        var suffix = null;
        if (t.classList.contains("js-weapon-sel-A")) suffix = "A";
        else if (t.classList.contains("js-weapon-sel-B")) suffix = "B";
        else if (t.classList.contains("js-weapon-sel")) suffix = "A"; // legacy fallback
        if (!suffix) return;
        var r = t.closest(".js-unit-dashboard");
        if (!r) return;
        updateSlot(r, suffix, t.value);
        syncSelectors(r);
    }, true);
})();

dv.container.innerHTML = `
<style>
    /* HIDE DEFAULT OBSIDIAN TITLE SO ONLY OUR HUD SHOWS */
    .markdown-rendered h1:first-child, .inline-title { display: none !important; }

    @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&display=swap');

    /* â”€â”€ OUTER WRAPPER â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
    .hud-outer-v13 {
        position: relative; width: 100%;
        aspect-ratio: 1654 / 869;
        max-width: 1654px; max-height: 869px; margin: 0 auto 40px;
        background: #080808; border: 1px solid #3a3a3a;
        font-family: 'Orbitron', sans-serif !important; color: #fff;
        display: flex; flex-direction: column;
        box-shadow: 0 10px 40px rgba(0,0,0,0.9); box-sizing: border-box;
        overflow: hidden;
    }

    /* â”€â”€ SCROLLBARS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
    .ryke-scrollbox::-webkit-scrollbar { width: 3px; }
    .ryke-scrollbox::-webkit-scrollbar-thumb { background: #be63ff; border-radius: 10px; }
    .ryke-scrollbox { overflow-y: auto !important; scrollbar-width: thin; scrollbar-color: #be63ff #111; }

    /* â”€â”€ TOP BAR â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
    /* Character art bleeds in from the right as an absolute img.          */
    /* Content occupies the left ~60%, always readable.                    */
    .top-bar {
        position: relative; width: 100%; overflow: hidden;
        background: linear-gradient(135deg, #0e0e0e 0%, #141414 100%);
        border-bottom: 2px solid #be63ff;
    }
    /* Dark left-to-right gradient overlay keeps text readable over art */
    .top-bar::after {
        content: ''; position: absolute; inset: 0; z-index: 1;
        background: linear-gradient(to right, #0e0e0e 38%, rgba(14,14,14,0.85) 58%, rgba(14,14,14,0.2) 80%, transparent 100%);
        pointer-events: none;
    }
    /* Character art â€” absolute, right-aligned */
    .top-hero-img {
        position: absolute; right: 0; top: 0;
        height: 100%; width: 50%;
        /* 120% altura: zoom forte â€” corta bordas, modelo maior na faixa (tipo cover-ish) */
        background-size: auto 120%; background-position: top center;
        background-repeat: no-repeat;
        z-index: 0; display: block; pointer-events: none;
        /* Fade the left edge smoothly into the dark background */
        -webkit-mask-image: linear-gradient(to right, transparent 0%, black 30%);
        mask-image: linear-gradient(to right, transparent 0%, black 30%);
    }
    /* Content block â€” sits above the gradient overlay */
    .top-content {
        position: relative; z-index: 2;
        padding: 16px 24px; max-width: 62%;
        display: flex; flex-direction: column; gap: 6px;
    }

    /* â”€â”€ BADGES & NAME â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
    .badge-row { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .pts-badge-new { background: #00ff88; color: #000; padding: 2px 10px; font-weight: 900; font-size: 0.78rem; display: inline-block; clip-path: polygon(8px 0,100% 0,calc(100% - 8px) 100%,0 100%); }
    .unique-badge  { background: #ff3366; color: #fff; padding: 2px 10px; font-weight: 900; font-size: 0.78rem; display: inline-block; clip-path: polygon(8px 0,100% 0,calc(100% - 8px) 100%,0 100%); }
    .hud-main-name { font-size: 1.9rem !important; font-weight: 900; text-transform: uppercase; line-height: 1; letter-spacing: -1px; color: #fff; text-shadow: 0 2px 8px rgba(0,0,0,0.9); margin: 2px 0; }
    .kw-row { display: flex; flex-wrap: wrap; gap: 4px; }
    .model-kw { font-size: 0.58rem; background: rgba(255,255,255,0.08); color: #ccc; border: 1px solid rgba(255,255,255,0.25); padding: 2px 6px; text-transform: uppercase; font-weight: bold; border-radius: 2px; }

    /* â”€â”€ STATS ROW â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
    /* All 8 stats in one flex row. Core=cyan border, Defense=purple border */
    .all-stats-row { display: flex; gap: 5px; flex-wrap: wrap; align-items: flex-start; margin-top: 2px; }
    .stat-box {
        display: flex; flex-direction: column; align-items: center;
        background: rgba(0,0,0,0.65); border: 1px solid rgba(0,255,255,0.3);
        padding: 3px 10px; border-radius: 2px; cursor: help; min-width: 48px;
        box-sizing: border-box;
    }
    .stat-box.def { border-color: rgba(190,99,255,0.4); }
    .stat-box.vida { border-color: rgba(255,50,100,0.5); }
    .stat-lbl { font-size: 0.5rem; font-weight: 900; text-transform: uppercase; letter-spacing: 0.5px; color: #00ffff; line-height: 1.2; }
    .stat-box.def  .stat-lbl { color: #be63ff; }
    .stat-box.vida .stat-lbl { color: #ff6688; }
    .stat-val { font-size: 1.05rem; font-weight: 900; color: #fff; line-height: 1.1; margin-top: 1px; padding: 0 1px; box-sizing: border-box; }
    .stat-div { width: 1px; background: rgba(190,99,255,0.3); align-self: stretch; margin: 0 3px; }
    .date-line { font-size: 0.55rem; color: #555; font-family: monospace; margin-top: 4px; }

    /* â”€â”€ BODY GRID â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
    .hud-body-grid {
        display: grid; grid-template-columns: 1fr minmax(200px,260px) minmax(200px,260px);
        background: #0d0d0d; flex-grow: 1; min-height: 0;
        border-top: 0;
    }
    .col-abilities { padding: 18px 20px; border-right: 1px solid #242424; display: flex; flex-direction: column; gap: 8px; min-height: 0; }
    .col-slot {
        padding: 10px 10px 40px 10px; display: flex; flex-direction: column;
        min-height: 0; gap: 6px; box-sizing: border-box; align-self: stretch;
        border-right: 1px solid #1a1a1a;
    }
    .col-slot:last-child { border-right: none; }
    .slot-head { flex-shrink: 0; }
    .slot-scroll { flex: 1; min-height: 0; }

    /* â”€â”€ ABILITY / TAG ELEMENTS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
    .model-tag  { font-size: 0.68rem; background: rgba(0,0,0,0.7); color: #fff; border: 1px solid rgba(0,191,255,0.45); padding: 3px 7px; text-transform: uppercase; font-weight: bold; border-radius: 2px; display: inline-block; cursor: help; }
    .weapon-tag { font-size: 0.68rem; background: rgba(0,0,0,0.7); color: #fff; border: 1px solid rgba(0,255,255,0.45); padding: 3px 7px; text-transform: uppercase; font-weight: bold; border-radius: 2px; display: inline-block; cursor: help; }
    .section-label { font-size: 0.8rem; color: #be63ff; font-weight: 900; text-transform: uppercase; letter-spacing: 2px; border-bottom: 1px solid rgba(190,99,255,0.2); padding-bottom: 4px; margin-bottom: 12px; }

    /* â”€â”€ WEAPON SELECTOR (compact for dual slots) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
    .weapon-selector-wrapper {
        position: relative; width: 100%; height: 28px;
        background: rgba(0,255,255,0.04); border: 1px solid rgba(0,255,255,0.4); border-radius: 3px; margin-bottom: 6px;
        transition: all 0.2s;
    }
    .weapon-selector-wrapper:hover { background: rgba(0,255,255,0.1); border-color: #00ffff; }
    .weapon-selector-display { position: absolute; inset: 0; display: flex; align-items: center; padding-left: 8px; padding-right: 22px; color: #00ffff; font-weight: 900; font-size: 0.62rem; text-transform: uppercase; pointer-events: none; z-index: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .weapon-selector-wrapper::after { content: ''; position: absolute; right: 8px; top: 50%; transform: translateY(-50%); width: 10px; height: 10px; background: url('data:image/svg+xml;charset=US-ASCII,%3Csvg xmlns%3D\"http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg\" width%3D\"292\" height%3D\"292\"%3E%3Cpath fill%3D\"%2300ffff\" d%3D\"M287 69a18 18 0 0 0-13-5H18a18 18 0 0 0-13 18c0 5 2 9 5 13l128 128c4 4 8 5 13 5s9-1 13-5l128-128c4-4 5-8 5-13 0-5-2-9-5-13z\"%2F%3E%3C%2Fsvg%3E') center/contain no-repeat; pointer-events: none; z-index: 1; }
    .weapon-selector {
        position: absolute; inset: 0; width: 100%; height: 100%; margin: 0;
        padding: 0 22px 0 8px; box-sizing: border-box; border: none; border-radius: 3px;
        cursor: pointer; z-index: 4; opacity: 1; color: transparent;
        -webkit-text-fill-color: transparent; background-color: transparent;
        font-family: inherit; font-size: max(16px, 0.7rem); line-height: 28px;
        appearance: none; -webkit-appearance: none; -moz-appearance: none;
    }

    /* â”€â”€ SLOT INFO BAR (peso + pts prominent) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
    .slot-info-bar {
        display: flex; align-items: center; gap: 6px; margin-bottom: 6px; flex-wrap: wrap;
    }
    .slot-peso-badge {
        display: inline-flex; align-items: center; gap: 3px;
        background: rgba(0,255,255,0.08); border: 1px solid rgba(0,255,255,0.35);
        padding: 2px 8px; border-radius: 3px;
    }
    .slot-peso-badge .spb-val { font-size: 0.9rem; font-weight: 900; color: #00ffff; line-height: 1; }
    .slot-peso-badge .spb-lbl { font-size: 0.45rem; font-weight: 800; color: #00ffff; opacity: 0.85; letter-spacing: 0.4px; }
    .slot-pts-badge {
        display: none; align-items: center;
        background: rgba(0,255,136,0.1); border: 1px solid rgba(0,255,136,0.4);
        padding: 2px 8px; border-radius: 3px;
        font-size: 0.6rem; font-weight: 900; color: #00ff88; letter-spacing: 0.5px;
    }
    .slot-pts-badge.is-visible { display: inline-flex; }

    /* â”€â”€ WEAPON STATS GRID (compact for dual slots) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
    .col-slot .w-stats-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; margin-bottom: 6px; }
    .col-slot .w-stats-grid .w-stat-item {
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        background: rgba(0,0,0,0.65); border: 1px solid rgba(0,255,255,0.3);
        padding: 2px 4px; border-radius: 2px; box-sizing: border-box;
        min-height: 38px; max-height: 38px; min-width: 0; width: 100%;
    }
    .col-slot .w-stats-grid .w-stat-lbl { font-size: 0.45rem; font-weight: 900; color: #00ffff; letter-spacing: 0.4px; text-transform: uppercase; line-height: 1.2; }
    .col-slot .w-stats-grid .w-stat-val {
        font-size: 0.9rem; font-weight: 900; color: #fff; line-height: 1.1; margin-top: 1px;
        max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; text-align: center;
    }

    /* â”€â”€ TOOLTIPS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
    .tc-tooltip { position: relative; cursor: help; }
    .tc-tooltip:hover::after { content: attr(data-desc); position: absolute; bottom: 120%; left: 0; width: max-content; max-width: 240px; background: #000; color: #ddd; border: 1px solid #444; border-left: 3px solid #be63ff; padding: 10px; font-family: sans-serif; font-size: 0.85rem; line-height: 1.4; font-weight: normal; white-space: normal; text-transform: none; z-index: 9999; pointer-events: none; }

    /* â”€â”€ BUTTONS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
    .dl-btn    { position: absolute; bottom: 6px; right: 6px;   background: #222; color: #fff; border: none; padding: 4px 10px; font-size: 0.65rem; cursor: pointer; font-family: Orbitron; z-index: 10; }
    .print-btn { position: absolute; bottom: 6px; right: 82px;  background: #222; color: #fff; border: none; padding: 4px 10px; font-size: 0.65rem; cursor: pointer; font-family: Orbitron; z-index: 10; }
    .dl-btn:hover, .print-btn:hover { background: #be63ff; color: #000; }

    /* â”€â”€ PRINT MODE â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
    .print-mode .top-bar { background: #fff !important; border-color: #000 !important; }
    .print-mode .top-bar::after { display: none !important; }
    .print-mode .top-hero-img { display: none !important; }
    .print-mode .top-content { max-width: 100% !important; }
    .print-mode .hud-main-name { color: #000 !important; text-shadow: none !important; }
    .print-mode .pts-badge-new { background: transparent !important; color: #000 !important; clip-path: none !important; border: none !important; font-weight: 900; }
    .print-mode .pts-badge-new span { text-shadow: none !important; -webkit-text-stroke: 0 !important; }
    .print-mode .unique-badge  { background: transparent !important; color: #000 !important; clip-path: none !important; border: 1px solid #000 !important; }
    .print-mode .elite-badge  { background: transparent !important; color: #000 !important; clip-path: none !important; border: 1px solid #000 !important; }
    .print-mode .mercenary-badge { background: transparent !important; color: #000 !important; clip-path: none !important; border: 1px solid #000 !important; }
    .print-mode .model-kw  { background: transparent !important; color: #000 !important; border-color: #000 !important; }
    .print-mode .stat-box  { background: #fff !important; border-color: #000 !important; }
    .print-mode .stat-lbl  { color: #000 !important; }
    .print-mode .stat-val  { color: #000 !important; }
    .print-mode .hud-body-grid { background: #fff !important; }
    .print-mode .col-abilities { border-color: #000 !important; }
    .print-mode .col-slot .w-stats-grid .w-stat-item { background: #fff !important; border-color: #000 !important; }
    .print-mode .col-slot .w-stats-grid .w-stat-val, .print-mode .col-slot .w-stats-grid .w-stat-lbl { color: #000 !important; }
    .print-mode .slot-peso-badge { background: #fff !important; border: 1px solid #000 !important; }
    .print-mode .slot-peso-badge .spb-val, .print-mode .slot-peso-badge .spb-lbl { color: #000 !important; }
    .print-mode .slot-pts-badge { background: #fff !important; border: 1px solid #000 !important; color: #000 !important; }
