                <div class="stat-box def tc-tooltip" data-desc="${coreRules.melee}"><span class="stat-lbl">MELEE</span><span class="stat-val" id="t-def-melee-${uid}">ðŸ›¡ï¸ âš”ï¸ ${p.armadura_melee}</span></div>
                <div class="stat-box def tc-tooltip" data-desc="${coreRules.ranged}"><span class="stat-lbl">RANGED</span><span class="stat-val" id="t-def-ranged-${uid}">ðŸ›¡ï¸ ðŸ”« ${p.armadura_ranged}</span></div>
