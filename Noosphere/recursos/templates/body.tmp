        <!-- SLOT A -->
        <div class="col-slot">
            <div class="slot-head">
                <div style="font-size:0.45rem;font-weight:900;color:#00ffff;letter-spacing:1.5px;text-transform:uppercase;margin-bottom:4px;opacity:0.7;">SLOT 1</div>
                <div class="weapon-selector-wrapper">
                    <div id="w-sel-display-A-${uid}" class="weapon-selector-display">â€” ESCOLHA â€”</div>
                    <select class="weapon-selector js-weapon-sel-A" data-uid="${uid}" id="w-sel-A-${uid}">${weaponOptionsHtml}</select>
                </div>
                <div class="slot-info-bar">
                    <div class="slot-peso-badge"><span class="spb-val" id="w-peso-A-${uid}">0</span><span class="spb-lbl">PESO</span></div>
                    <div class="slot-pts-badge" id="w-pts-mod-A-${uid}"></div>
                    <div id="w-kws-A-${uid}" style="display:flex;flex-wrap:wrap;gap:3px;flex:1;min-width:0;"></div>
