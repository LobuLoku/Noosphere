/* ==========================================================
   LÃ“GICA DO SISTEMA (V13.0 - RELATIONAL ABILITIES & KEYWORDS)
   ========================================================== */

let p = dv.current();
if ((!p || !p.file) && typeof app !== "undefined" && dv.currentFilePath) {
  try {
    const fp = dv.currentFilePath;
    const f = app.vault.getAbstractFileByPath(fp);
    const mc = app.metadataCache.getCache(fp);
    if (f && mc && mc.frontmatter && "stat" in f) {
      p = Object.assign({}, mc.frontmatter, {
        file: {
          path: f.path,
          name: f.name,
          basename: f.basename,
          extension: f.extension,
          mtime: f.stat.mtime,
        },
      });
    }
  } catch (_e) {}
}
if ((!p || !p.file) && typeof app !== "undefined") {
  try {
    const af = app.workspace.getActiveFile();
    if (af && af.path === dv.currentFilePath) {
      const cand = dv.page(af.path);
      if (cand && cand.file) p = cand;
    }
  } catch (_e2) {}
}
if (!p || !p.file) {
  dv.paragraph("*Erro: metadata da ficha nÃ£o disponÃ­vel no Ã­ndice Dataview. Em DefiniÃ§Ãµes â†’ Dataview: experimente Â«Refresh IndexÂ» / Â«RebuildÂ» ou confira o YAML da nota.*");
  return;
}
/** Obsidian pode usar origin https:// â€” nÃ£o confiar em window.location para isto */
const isObsidian = typeof app !== "undefined";

// 1. CORE RULES
const coreRules = {
  mov: "MOVIMENTO: DistÃ¢ncia mÃ¡xima em polegadas que o modelo pode se deslocar com uma aÃ§Ã£o de movimento, medida no terreno.",
  vida: "VIDA: Quantidade de dano que o modelo pode sofrer antes de ser destruÃ­do.",
  dec: "DECOERÃŠNCIA: Quanto o esquadrÃ£o Ã© afetado quando esta unidade morre â€” representa a coesÃ£o do grupo. DecoerÃªncia acumulada demais passa a gerar problemas ou penalidades ao squad.",
  ap: "AP: Quantidade de aÃ§Ãµes que o modelo pode gastar por ativaÃ§Ã£o (habilidades, manobras, etc.).",
  peso: "PESO MÃX: O limite de peso total que este modelo pode carregar em utilitÃ¡rios e armas.",
  melee: "DEFESA CORPO A CORPO: Quanto de dano corpo a corpo o modelo absorve antes que o excesso cause dano Ã  vida.",
  ranged: "DEFESA Ã€ DISTÃ‚NCIA: Quanto de dano Ã  distÃ¢ncia o modelo absorve antes que o excesso cause dano Ã  vida.",
  special: "DEFESA ESPECIAL: Quanto de dano especial o modelo absorve antes que o excesso cause dano Ã  vida."
};

// ArrayBuffer to Base64 Helper
function bufferToBase64(buf) {
    var binStr = '';
    var bytes = new Uint8Array(buf);
    var len = bytes.byteLength;
    for (var i = 0; i < len; i++) {
        binStr += String.fromCharCode(bytes[i]);
    }
    return window.btoa(binStr);
}

async function resolveImgBase64(imgRaw) {
    if (!imgRaw) return "";
    let path = imgRaw.path || String(imgRaw).replace(/\[\[|\]\]/g, '');
    if (!path) return "";
    if (path.startsWith("http")) return path;
    if (isObsidian) {
        const file = app.metadataCache.getFirstLinkpathDest(path, p.file.path);
        if (file) {
            let buffer = await app.vault.readBinary(file);
            let b64 = bufferToBase64(buffer);
            let ext = file.extension.toLowerCase();
            let mime = (ext === 'jpg' || ext === 'jpeg') ? 'image/jpeg' : (ext === 'webp' ? 'image/webp' : 'image/png');
            return `data:${mime};base64,${b64}`;
        }
    }
    return path;
}

// 2. FETCH WEAPONS / UTILITIES (from utility_list property)
function resolveLinkedUtilityPage(pathStr) {
  let pg = dv.page(pathStr);
  if (pg) return pg;
  const baseName = pathStr.replace(/\\/g, "/").split("/").pop().replace(/\.md$/i, "");
  let found = null;
  dv.pages().forEach(function (q) {
    if (found) return;
    if (q.file.name.replace(/\.md$/i, "") === baseName) found = q;
  });
  return found;
}

let availableWeapons = [];
// Read utility_list (YAML list) â€” fallback to legacy utility1..utility10
let utilityLinks = [];
if (p.utility_list && Array.isArray(p.utility_list) && p.utility_list.length > 0) {
  utilityLinks = p.utility_list;
} else if (p.utility_list && typeof p.utility_list === "string" && p.utility_list.trim()) {
  utilityLinks = [p.utility_list];
} else {
  // Legacy fallback: utility1..utility10
  for (let i = 1; i <= 10; i++) {
    let uLink = p[`utility${i}`];
    if (uLink) utilityLinks.push(uLink);
  }
}
for (const uLink of utilityLinks) {
  if (!uLink) continue;
  let path = uLink.path || String(uLink).replace(/\[\[|\]\]/g, '').trim();
  if (!path) continue;
  let wPage = resolveLinkedUtilityPage(path);
  if (wPage) {
     let wImgRaw = wPage.utility_image || wPage.model_image || "";
     let wImgB64 = await resolveImgBase64(wImgRaw);
     const atk = wPage.equipamento_ataques;
     const mir = wPage.equipamento_mira;
     const dist = wPage.equipamento_distancia;
     const dmg = wPage.damage_type;
     const pes = wPage.equipamento_loadout;
     const pmRaw = wPage.point_mod;
     const hasPointMod = pmRaw !== undefined && pmRaw !== null && String(pmRaw).trim() !== "";

     availableWeapons.push({
         name: wPage.file?.name || path.split('/').pop().replace('.md',''),
         tipo: wPage.tipo || "Weapon",
         image: wImgB64,
         ataques: atk != null && atk !== '' ? atk : null,
         mira: mir != null && mir !== '' ? mir : null,
         distancia: dist != null && dist !== '' ? dist : null,
         dano: dmg != null && dmg !== '' ? dmg : null,
         peso: pes != null && pes !== '' ? pes : null,
         point_mod: hasPointMod ? pmRaw : null,
         equipamento_ataques: atk,
         equipamento_mira: mir,
         equipamento_distancia: dist,
         damage_type: dmg,
         equipamento_loadout: pes,
         keywords: wPage.equipamento_keywords || [],
         caracteristicas: wPage.equipamento_caracteristicas || [],
         passivas_de_utility: wPage.passivas_de_utility || []
     });
  }
}

function fmtPmSuffix(pm) {
  if (pm == null || pm === "") return "";
  const n = parseInt(pm, 10);
  if (isNaN(n)) return "";
  return ` (${n > 0 ? "+" : ""}${n} pts)`;
}
const weaponOptionsHtml =
  `<option value="">â€” Escolha â€”</option>` +
  `<option value="__none__">Sem loadout</option>` +
  availableWeapons.map(w => `<option value="${w.name}">${w.name}${fmtPmSuffix(w.point_mod)}</option>`).join('');

// 2.5 FETCH FACTIONS â€” mecÃ¢nica no YAML das pÃ¡ginas Wargame/03 FacÃ§Ãµes (Guia de TÃ¡ticas.md).
function legacyTacticsFromBanner(f) {
    const arr = [];
    for (let n = 1; n <= 12; n++) {
        const nm = f[`tactic${n}_name`];
        if (nm) arr.push({ nome: String(nm).trim(), efeitos: {} });
    }
    return arr;
}

const factionsRaw = dv.pages('"Wargame/03 FacÃ§Ãµes"').map(f => {
    const tacDescMap = {};
    (f.file.lists || []).forEach(l => {
        const txt = l.text;
        if (txt.includes(':')) {
            const colonIdx = txt.indexOf(':');
            const key = txt.substring(0, colonIdx).trim().toLowerCase();
            const val = txt.substring(colonIdx + 1).trim();
            tacDescMap[key] = val;
        }
    });
    const rawT = (f.taticas && f.taticas.length > 0) ? f.taticas : legacyTacticsFromBanner(f);
    const taticas = rawT.map(t => ({
        ...t,
        descricao: tacDescMap[String(t.nome || '').toLowerCase()] || ''
    }));
    return {
        name: f.file.name,
        noosphera: f.noosphera,
        taticas
    };
}).array();

// 3. GLOSSÃRIOS (arma + utilities + passivas de modelo: Wargame/05 GlossÃ¡rios/GlossÃ¡rio - Passivas.md)
const haGlos = dv.page("Wargame/05 GlossÃ¡rios/GlossÃ¡rio - AÃ§Ãµes.md")?.file?.lists || [];
const hpGlos = dv.page("Wargame/05 GlossÃ¡rios/GlossÃ¡rio - Passivas.md")?.file?.lists || [];

const buildMap = (lists) => {
    let m = {};
    lists.forEach(l => {
        let txt = l.text;
        if (txt.includes(':')) {
            let [k, d] = txt.split(':');
            m[k.trim().toLowerCase()] = d.trim();
        }
    });
    return m;
};
const activeMap = buildMap(haGlos);
const passiveMap = buildMap(hpGlos);
const weaponMap = passiveMap;
const utilityPassiveMap = passiveMap;
const weaponMapJSON = JSON.stringify(weaponMap).replace(/'/g, "&#39;");

// 4. PREPARAÃ‡ÃƒO DE TAGS E REGRAS
const mercKwTooltip =
    "MercenÃ¡rios podem integrar esquadrÃµes de qualquer facÃ§Ã£o na mesma Noosphera, sem custo extra por facÃ§Ã£o cruzada.";
const kwMap = {
    elite: "Elites sÃ£o modelos especiais que em alguns exÃ©rcitos sÃ£o limitados.",
    unique: "UNIQUE significa que vocÃª nÃ£o pode pegar mais de um daquele model do seu squad.",
    mercenary: mercKwTooltip,
    mercenÃ¡rio: mercKwTooltip,
    mercenario: mercKwTooltip,
    mercenarios: mercKwTooltip,
};
function stripD(s) {
    return String(s || "")
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .toLowerCase()
        .trim();
}
function kwNormBare(k) {
    return stripD(k);
}
function kwListHasToken(list, tokens) {
    const arr = Array.isArray(tokens) ? tokens : [tokens];
    return list.some((k) => {
        const x = kwNormBare(k);
        return arr.some((t) => x === t);
    });
}
function isBadgeKwInRow(k) {
    const x = kwNormBare(k);
    return x === "unique" || x === "elite" || x === "mercenary" || x === "mercenario" || x === "mercenarios";
}

/** ELITE jÃ¡ vai no badge do topo â€” nÃ£o repetir na coluna de passivas/caracterÃ­sticas do modelo (Ãºnico filtro deste tipo). */
function omitEliteMirrorList(listRaw) {
    const list = Array.isArray(listRaw) ? listRaw : listRaw ? String(listRaw).split(",").map((s) => s.trim()) : [];
    return list.filter((item) => kwNormBare(item) !== "elite");
}

const renderTags = (tags, map, cssClass) => {
    const list = Array.isArray(tags) ? tags : (tags ? String(tags).split(',').map(s => s.trim()) : []);
    return list.map(item => {
        let k = String(item).toLowerCase();
        let desc = map[k] || "Regra especial (PÃ¡gina nÃ£o encontrada).";
        desc = desc.replace(/"/g, '&quot;').replace(/'/g, '&#39;');
        return `<span class="${cssClass} tc-tooltip" data-desc="${desc}">${item}</span>`;
    }).join('');
};

/** CaracterÃ­sticas de modelo: mesmo formato das passivas na coluna, glossÃ¡rio em GlossÃ¡rio - Passivas (Passivas padrÃ£o). */
const MODEL_CHAR_COLOR = "#d8b4fe";
const renderCaracteristicas = (listRaw, map, color) => {
    const list = Array.isArray(listRaw) ? listRaw : (listRaw ? String(listRaw).split(',').map(s => s.trim()) : []);
    if (list.length === 0) return "";
    return list.map(item => {
        let k = String(item).toLowerCase();
        let desc = map[k] || "DescriÃ§Ã£o nÃ£o encontrada no glossÃ¡rio.";
        let apCost = "";
        let cleanDesc = desc;
        const apMatch = desc.match(/^\[([ðŸ”´]+)\]\s*/);
        if (apMatch) {
            apCost = `<span style="margin-left: 5px; font-size: 0.78rem; letter-spacing: 1px;">${apMatch[1]}</span>`;
            cleanDesc = desc.substring(apMatch[0].length);
        }
        return `<div class="model-char-row" data-char-key="${k.replace(/"/g, '&quot;')}" style="margin-bottom: 3px; font-family: sans-serif; font-size: 0.82rem; line-height: 1.35; background: transparent; padding: 2px 8px; border-left: 3px solid ${color}; break-inside: avoid; page-break-inside: avoid;">
            <strong style="color: ${color}; text-transform: uppercase; font-size: 0.88rem;">${item}${apCost}:</strong>
            <span style="color: #ccc;">${cleanDesc}</span>
        </div>`;
    }).join('');
};

const caracteristicasHtml = renderCaracteristicas(omitEliteMirrorList(p.caracteristicas), passiveMap, MODEL_CHAR_COLOR);

// KEYWORDS (FacÃ§Ã£o e Noosphera primeiro)
let rawKws = Array.isArray(p.keywords) ? p.keywords : (p.keywords ? String(p.keywords).split(',').map(s => s.trim()) : []);
let kwList = [];
if (p.noosphera) kwList.push(p.noosphera);
if (p.faccao) {
    if (Array.isArray(p.faccao)) kwList.push(...p.faccao);
    else kwList.push(p.faccao);
}
rawKws.forEach(k => { if(!kwList.includes(k)) kwList.push(k); });

const charsLower = p.caracteristicas
    ? (Array.isArray(p.caracteristicas) ? p.caracteristicas : String(p.caracteristicas).split(","))
          .map((c) => c.trim().toLowerCase())
    : [];

const isUnique =
    kwListHasToken(kwList, "unique") || charsLower.includes("unique");
const isElite =
    kwListHasToken(kwList, "elite") || charsLower.includes("elite");
const isMerc = kwListHasToken(kwList, ["mercenary", "mercenario", "mercenarios"]);

const roleBadgesHtml =
    (isUnique ? `<span class="unique-badge">UNIQUE</span>` : "") +
    (isElite ? `<span class="elite-badge">ELITE</span>` : "") +
    (isMerc ? `<span class="mercenary-badge">MERCENARY</span>` : "");

const kwRowList = kwList.filter((k) => !isBadgeKwInRow(k));
const modelKwTags = kwRowList
    .map((k) => {
        let kl = k.toLowerCase();
        let kd = kwNormBare(k);
        let tip = kwMap[kl] || kwMap[kd];
        if (tip) {
            let desc = tip.replace(/"/g, "&quot;").replace(/'/g, "&#39;");
            return `<span class="model-kw tc-tooltip" data-desc="${desc}">${k}</span>`;
        }
        return `<span class="model-kw">${k}</span>`;
    })
    .join("");

// HABILIDADES DINÃ‚MICAS
const renderAbilities = (listRaw, map, typeLabel, color) => {
    const list = Array.isArray(listRaw) ? listRaw : (listRaw ? String(listRaw).split(',').map(s => s.trim()) : []);
    if (list.length === 0) return "";
    return list.map(item => {
        let k = String(item).toLowerCase();
        let desc = map[k] || "DescriÃ§Ã£o nÃ£o encontrada no glossÃ¡rio.";
        let apCost = "";
