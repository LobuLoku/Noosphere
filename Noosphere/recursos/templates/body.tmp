    return String(u || "").replace(/\\/g, "\\\\").replace(/'/g, "\\'");
}

const updatedDate = window.moment ? window.moment(p.file.mtime).format("DD/MM/YYYY") : new Date(p.file.mtime).toLocaleDateString();

// 5. UI HTML INJECTION
let uid = "uid_" + Math.random().toString(36).substr(2, 9);

// Serialize data for the global engine (URI-encoded like Template â€” export-fixes decodeURIComponent)
const dataWeapons = encodeURIComponent(JSON.stringify(availableWeapons));
/** JSON completo dentro do HUD â€” data-weapons no atributo quebra com imagens base64 grandes no export HTML */
const weaponsJsonEmbedded = JSON.stringify(availableWeapons).replace(/</g, '\\u003c');
