```dataviewjs
/**
 * Carrossel = mesmo markup/CSS de Wargame/Models.md (nb-card).
 * Render: createEl + innerHTML (dv.paragraph quebra HTML complexo no Obsidian).
 */
let cur = dv.current();
if ((!cur || !cur.file) && typeof app !== "undefined" && dv.currentFilePath) {
  try {
    const fp = dv.currentFilePath;
    const f = app.vault.getAbstractFileByPath(fp);
    const mc = app.metadataCache.getCache(fp);
    if (f && mc && mc.frontmatter && "stat" in f) {
      cur = Object.assign({}, mc.frontmatter, {
        file: {
          path: f.path,
          name: f.name,
          basename: f.basename,
          extension: f.extension,
          mtime: f.stat.mtime,
        },
      });
    }
  } catch (_e) {}
}
if ((!cur || !cur.file) && typeof app !== "undefined") {
  try {
    const af = app.workspace.getActiveFile();
    if (af && af.path === dv.currentFilePath) {
      const cand = dv.page(af.path);
      if (cand && cand.file) cur = cand;
    }
  } catch (_e2) {}
}
const isObs = typeof app !== "undefined";
const simBid = "sim_" + Math.random().toString(36).slice(2, 10);

if (!cur?.file?.path) {
  const err = dv.container.createEl("div");
  err.textContent = "Modelos similares: nÃ£o foi possÃ­vel ler o ficheiro atual (metadata indisponÃ­vel).";
} else {
const SPECIAL_KWS = ["elite", "unique"];

function kwBareMercCarousel(k) {
  return String(k || "")
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .toLowerCase()
    .trim();
}
function isMercKwCarousel(k) {
  const x = kwBareMercCarousel(k);
  return x === "mercenary" || x === "mercenario" || x === "mercenarios";
}

/** Exige .file â€” entradas sem nota (pasta, etc.) quebravam o .sort() com a.q.file */
const allPages = dv
  .pages('"Wargame/02 Models"')
  .where((p) => p && p.file && p.file.path && (p.tipo === "Model" || p.faccao !== undefined));

function norm(s) {
  return String(s || "").trim().toLowerCase();
}

function esc(s) {
  return String(s || "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
}

function buildTagSet(page) {
  const set = new Set();
  if (!page) return set;
  if (page.noosphera) set.add(norm(page.noosphera));
  const facs = Array.isArray(page.faccao) ? page.faccao : (page.faccao ? [page.faccao] : []);
  facs.forEach(f => { if (f) set.add(norm(f)); });
  const kws = Array.isArray(page.keywords)
    ? page.keywords
    : (page.keywords ? String(page.keywords).split(",").map(t => t.trim()) : []);
  kws.forEach(k => { if (k) set.add(norm(k)); });
  return set;
}

const myTags = buildTagSet(cur);
const myPath = cur.file.path;

function overlapScore(other) {
  if (!other || !other.file || !other.file.path) return -1;
  if (other.file.path === myPath) return -1;
  const ot = buildTagSet(other);
  let n = 0;
  myTags.forEach(t => {
    if (t && ot.has(t)) n++;
  });
  return n;
}

const scored = allPages
  .map((q) => ({ q, s: overlapScore(q) }))
  .filter((x) => x.s > 0 && x.q && x.q.file && x.q.file.path)
  .sort((a, b) => {
    const byScore = b.s - a.s;
    if (byScore !== 0) return byScore;
    const na = (a.q.file && a.q.file.name) || "";
    const nb = (b.q.file && b.q.file.name) || "";
    return String(na).localeCompare(String(nb));
  });

const chip = (txt, color, bg) =>
  `<span style="font-size:.7rem;padding:4px 12px;border:1px solid ${color};color:${color};background:${bg};border-radius:20px;text-transform:uppercase;font-weight:300;white-space:nowrap;font-family:'Orbitron',sans-serif;letter-spacing:1px;box-shadow:0 0 10px ${color}33;">${esc(txt)}</span>`;

function cardHtml(p, matchScore) {
  if (!p || !p.file || !p.file.path) return "";
  let imgSrc = "";
  let rawPath = "";
  if (isObs && p.model_image) {
    const raw = p.model_image?.path || String(p.model_image).replace(/\[\[|\]\]/g, "");
    const f = app.metadataCache.getFirstLinkpathDest(raw, p.file.path);
    if (f) {
      imgSrc = app.vault.adapter.getResourcePath(f.path);
      rawPath = f.path;
    }
  }

  const chars = Array.isArray(p.caracteristicas) ? p.caracteristicas : (p.caracteristicas ? String(p.caracteristicas).split(",").map(s => s.trim()) : []);
  const kws = Array.isArray(p.keywords) ? p.keywords : (p.keywords ? String(p.keywords).split(",").map(s => s.trim()) : []);
  const facs = Array.isArray(p.faccao) ? p.faccao : (p.faccao ? [p.faccao] : []);
  const specKwsModel = kws.filter(k => SPECIAL_KWS.includes(k.toLowerCase()) || isMercKwCarousel(k));
  const normKwsModel = kws.filter(k => !SPECIAL_KWS.includes(k.toLowerCase()) && !isMercKwCarousel(k));

  const loadouts = [];
  // Read utility_list first, fallback to legacy utility1..10
  let uList = [];
  if (p.utility_list && Array.isArray(p.utility_list) && p.utility_list.length > 0) {
    uList = p.utility_list;
  } else if (p.utility_list && typeof p.utility_list === "string" && p.utility_list.trim()) {
    uList = [p.utility_list];
  } else {
    for (let i = 1; i <= 10; i++) { const ul = p[`utility${i}`]; if (ul) uList.push(ul); }
  }
  for (const ul of uList) {
    if (!ul) continue;
    const rawU = ul?.path || String(ul).replace(/\[\[|\]\]/g, "").trim();
    const name = rawU.split("/").pop().replace(/\.md$/i, "");
    if (name) loadouts.push(name);
  }

  const tagsHtml = [
    chip(p.noosphera || "?", "#00ffff", "rgba(0,255,255,.06)"),
    ...facs.map(f => chip(String(f), "#be63ff", "rgba(190,99,255,.06)")),
    ...specKwsModel.map(k => chip(k, "#ff3366", "rgba(255,51,102,.08)")),
    ...chars.map(c => chip(c, "#00bfff", "rgba(0,191,255,.06)")),
    ...normKwsModel.map(k => chip(k, "rgba(255,255,255,.4)", "rgba(255,255,255,.04)")),
  ].join("");

  const matchLbl = matchScore + " tag" + (matchScore !== 1 ? "s" : "") + " em comum";

  return `
  <div class="nb-card js-card" data-nav="${p.file.path}">
    <div class="nb-img-box">
      <div class="nb-pts">${p.pontos ?? 0}<small>PTS</small></div>
      <div class="nb-sim-match">${esc(matchLbl)}</div>
      ${imgSrc
        ? `<img src="${esc(imgSrc)}" alt="" data-export-src="${esc(rawPath)}">`
        : `<div style="height:100%;display:flex;align-items:center;justify-content:center;"><span style="font-size:4rem;opacity:.08;">â¬¡</span></div>`}
      <div class="nb-armor">
        <div class="nb-armor-pill"><span>âš”ï¸</span><span>${p.armadura_melee ?? 0}</span></div>
        <div class="nb-armor-pill"><span>ðŸ”«</span><span>${p.armadura_ranged ?? 0}</span></div>
        <div class="nb-armor-pill"><span>âš ï¸</span><span>${p.armadura_special ?? 0}</span></div>
      </div>
    </div>
    <div class="nb-info">
      <div class="nb-name">${esc(p.file.name)}</div>
      <div class="nb-tags-row">${tagsHtml}</div>
      <div class="nb-stats">
        <div class="nb-stat"><span class="nb-stat-lbl">Movimento</span><span class="nb-stat-val c">${p.movimento ?? 0}</span></div>
        <div class="nb-stat"><span class="nb-stat-lbl">Vida</span><span class="nb-stat-val">${p.vida ?? 0}</span></div>
        <div class="nb-stat"><span class="nb-stat-lbl">DecoerÃªncia</span><span class="nb-stat-val c">${p.decoerencia ?? 0}</span></div>
        <div class="nb-stat"><span class="nb-stat-lbl">AP</span><span class="nb-stat-val">${parseInt(p.ap != null && p.ap !== "" ? p.ap : p.AP) || 0}</span></div>
      </div>
    </div>
    <div class="nb-loadout">
      <div class="nb-loadout-lbl">Loadout Inicial</div>
      <div class="nb-loadout-list">
        ${loadouts.length
          ? loadouts.map(l => `<span class="nb-litem">${esc(l)}</span>`).join("")
          : `<span style="font-size:.72rem;color:#333;">Nenhum equipamento</span>`}
      </div>
    </div>
  </div>`;
}

let simHtml = `
<style>
@import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@300;400;700&family=Inter:wght@200;300;400&display=swap');
#${simBid} * { box-sizing: border-box; }
#${simBid} { font-family: 'Inter', sans-serif !important; color: #e0d8f0 !important; width: 100%; margin-top: 48px; padding-top: 36px; border-top: 1px solid rgba(190, 99, 255, 0.22); }

#${simBid} .sim-head { display: flex; align-items: center; justify-content: center; margin-bottom: 24px; }
#${simBid} .sim-all-btn {
  display: inline-block; padding: 18px 40px; border-radius: 40px;
  border: 1px solid rgba(190, 99, 255, 0.5) !important; color: #f5f0ff !important; font-family: 'Orbitron', sans-serif;
  font-size: 14px; letter-spacing: 3px; text-transform: uppercase; text-decoration: none !important;
  background: rgba(190, 99, 255, 0.18) !important; transition: 0.25s; cursor: pointer;
  box-shadow: 0 8px 28px rgba(0, 0, 0, 0.35);
}
#${simBid} .sim-all-btn:hover { background: rgba(190, 99, 255, 0.32) !important; color: #fff !important; border-color: rgba(190, 99, 255, 0.75) !important; }

/* Carrossel: uma linha, setas, scroll oculto */
#${simBid} .nb-sim-carousel { display: flex; align-items: stretch; gap: 12px; position: relative; }
#${simBid} .nb-sim-arrow {
  flex: 0 0 44px; width: 44px; min-width: 44px; align-self: center; height: 120px;
  border: 1px solid rgba(190, 99, 255, 0.35) !important; border-radius: 16px;
  background: rgba(15, 5, 25, 0.75) !important; color: #d8b4fe !important; font-size: 2rem; line-height: 1;
  cursor: pointer; transition: 0.25s; font-family: 'Orbitron', sans-serif; padding: 0;
}
#${simBid} .nb-sim-arrow:hover { background: rgba(190, 99, 255, 0.25) !important; color: #fff !important; border-color: rgba(190, 99, 255, 0.7) !important; }
#${simBid} .nb-sim-arrow[disabled] { opacity: 0.25; pointer-events: none; }
#${simBid} .nb-sim-viewport {
  flex: 1; min-width: 0; overflow-x: auto; overflow-y: hidden;
  scroll-behavior: smooth; scroll-snap-type: x mandatory;
  scrollbar-width: none; -ms-overflow-style: none;
  padding-bottom: 8px;
}
#${simBid} .nb-sim-viewport::-webkit-scrollbar { display: none; }
#${simBid} .nb-sim-track { display: flex; gap: 30px; align-items: stretch; }

/* Cards = Tactical Browser (Models.md) */
#${simBid} .nb-card {
  background: rgba(15, 5, 25, 0.6) !important; border: 1px solid rgba(190, 99, 255, 0.12) !important;
  transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1) !important; cursor: pointer;
  display: flex; flex-direction: column; position: relative; border-radius: 24px; overflow: hidden;
  flex: 0 0 min(320px, calc(100vw - 140px)); scroll-snap-align: start; max-width: 380px;
}
#${simBid} .nb-card:hover { border-color: rgba(190, 99, 255, 0.5) !important; box-shadow: 0 25px 60px rgba(0, 0, 0, 0.6), 0 0 30px rgba(190, 99, 255, 0.2) !important; transform: translateY(-10px) !important; }

#${simBid} .nb-img-box { width: 100%; height: 340px; background: #05020a; overflow: hidden; position: relative; }
#${simBid} .nb-img-box img { width: 100%; height: 100%; object-fit: cover; object-position: top; display: block; transition: 0.8s; filter: grayscale(0.4) brightness(0.7); }
#${simBid} .nb-card:hover .nb-img-box img { filter: grayscale(0) brightness(1.1); transform: scale(1.08); }

#${simBid} .nb-pts { position: absolute; top: 18px; left: 18px; z-index: 5; background: rgba(0, 255, 136, 0.95) !important; color: #000 !important; font-weight: 700; font-size: 1.35rem; padding: 8px 18px; border-radius: 40px; box-shadow: 0 0 25px rgba(0, 255, 136, 0.4) !important; }
#${simBid} .nb-pts small { font-size: 10px; display: block; letter-spacing: 1px; font-weight: 400; text-transform: uppercase; margin-bottom: -2px; }

#${simBid} .nb-sim-match {
  position: absolute; bottom: 18px; left: 18px; z-index: 6; max-width: calc(100% - 36px);
  font-size: 10px; letter-spacing: 1px; text-transform: uppercase; font-weight: 600; font-family: 'Orbitron', sans-serif;
  color: #fff !important; padding: 8px 14px; border-radius: 12px;
  background: rgba(190, 99, 255, 0.92) !important; border: 1px solid rgba(255, 255, 255, 0.25); box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
}

#${simBid} .nb-armor { position: absolute; top: 18px; right: 18px; z-index: 5; display: flex; flex-direction: column; gap: 10px; }
#${simBid} .nb-armor-pill { background: rgba(5, 0, 10, 0.85); border: 1px solid rgba(190, 99, 255, 0.4) !important; padding: 10px 16px; border-radius: 40px; display: flex; align-items: center; gap: 12px; backdrop-filter: blur(10px); transition: 0.4s; }
#${simBid} .nb-armor-pill span:last-child { font-size: 1.15rem; font-weight: 300; color: #d8b4fe !important; font-family: 'Orbitron'; text-shadow: 0 0 10px rgba(190, 99, 255, 0.4); }
#${simBid} .nb-card:hover .nb-armor-pill { border-color: rgba(190, 99, 255, 0.7) !important; box-shadow: 0 0 20px rgba(190, 99, 255, 0.25) !important; }

#${simBid} .nb-info { padding: 28px 22px 0; flex-grow: 1; min-width: 0; }
#${simBid} .nb-name { font-size: 1.25rem; font-weight: 300; text-transform: uppercase; letter-spacing: 3px; color: #f5f0ff !important; margin-bottom: 12px; font-family: 'Orbitron', sans-serif !important; text-shadow: 0 0 15px rgba(190, 99, 255, 0.3) !important; }
#${simBid} .nb-tags-row { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 20px; }

#${simBid} .nb-stats {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 8px;
  margin-bottom: 20px;
  width: 100%;
  box-sizing: border-box;
}
#${simBid} .nb-stat {
  background: rgba(5, 0, 10, 0.5) !important;
  border: 1px solid rgba(190, 99, 255, 0.15) !important;
  padding: 10px 4px;
  text-align: center;
  border-radius: 12px;
  min-width: 0;
  overflow: hidden;
}
#${simBid} .nb-stat-lbl {
  font-size: 8px;
  color: #a99bbd !important;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  display: block;
  margin-bottom: 4px;
  font-weight: 300;
  line-height: 1.15;
  word-break: break-word;
  hyphens: auto;
}
#${simBid} .nb-stat-val {
  font-size: 1.2rem;
  font-weight: 300;
  color: #fff !important;
  display: block;
  line-height: 1;
  font-family: 'Orbitron';
}
#${simBid} .nb-stat-val.c { color: #80e5ff !important; text-shadow: 0 0 15px rgba(0, 217, 255, 0.4) !important; }

#${simBid} .nb-loadout { border-top: 1px solid rgba(190, 99, 255, 0.15) !important; padding: 25px; background: rgba(5, 0, 10, 0.3); }
#${simBid} .nb-loadout-lbl { font-size: 10px; color: #a99bbd !important; text-transform: uppercase; letter-spacing: 2px; margin-bottom: 12px; font-weight: 300; }
#${simBid} .nb-loadout-list { display: flex; flex-wrap: wrap; gap: 10px; }
#${simBid} .nb-litem { font-size: 11px; padding: 5px 15px; border: 1px solid rgba(0, 217, 255, 0.3) !important; color: #80e5ff !important; background: rgba(0, 217, 255, 0.1) !important; text-transform: uppercase; font-weight: 300; border-radius: 30px; letter-spacing: 1.5px; }

#${simBid} .sim-empty { color: #a99bbd !important; font-size: 12px; padding: 28px 16px; text-align: center; border: 1px dashed rgba(190, 99, 255, 0.2); border-radius: 16px; font-weight: 300; }
</style>
<div id="${simBid}">
  <div class="sim-head">
    <a class="internal-link sim-all-btn" data-link-path="Wargame/Models.md">VER MAIS MODELOS</a>
  </div>
`;

if (scored.length === 0) {
  simHtml += `<div class="sim-empty">Nenhum outro modelo compartilha noosphera, facÃ§Ã£o ou keyword com esta ficha. Use o botÃ£o acima para abrir o navegador completo.</div></div>`;
} else {
  simHtml += `
  <div class="nb-sim-carousel">
    <button type="button" class="nb-sim-arrow nb-sim-prev" aria-label="Anterior">â€¹</button>
    <div class="nb-sim-viewport">
      <div class="nb-sim-track">
        ${scored.map(({ q, s }) => cardHtml(q, s)).join("")}
      </div>
    </div>
    <button type="button" class="nb-sim-arrow nb-sim-next" aria-label="PrÃ³ximo">â€º</button>
  </div></div>`;
}

const simWrap = dv.container.createEl("div");
simWrap.innerHTML = simHtml;

if (scored.length > 0) {
  const sc = document.createElement("script");
  sc.textContent = `(function(){
  var root = document.getElementById("${simBid}");
  if(!root) return;
  var viewport = root.querySelector(".nb-sim-viewport");
  var track = root.querySelector(".nb-sim-track");
  var prev = root.querySelector(".nb-sim-prev");
  var next = root.querySelector(".nb-sim-next");
  if(!viewport || !track || !prev || !next) return;
  var cards = track.querySelectorAll(".nb-card");
  if(!cards.length) return;

  var gap = 30;
  function stepPx() {
    var c = cards[0];
    return (c ? c.getBoundingClientRect().width : 320) + gap;
  }
  function maxScroll() {
    return Math.max(0, viewport.scrollWidth - viewport.clientWidth);
  }
  function toggleArrows() {
    var m = maxScroll();
    var show = m > 8;
    prev.style.visibility = show ? "visible" : "hidden";
    next.style.visibility = show ? "visible" : "hidden";
    prev.disabled = !show;
    next.disabled = !show;
  }
  function goNext(e) {
    if(e){ e.preventDefault(); e.stopPropagation(); }
    var m = maxScroll();
    if(m <= 0) return;
    if(viewport.scrollLeft >= m - 6) viewport.scrollTo({ left: 0, behavior: "smooth" });
    else viewport.scrollBy({ left: stepPx(), behavior: "smooth" });
  }
  function goPrev(e) {
    if(e){ e.preventDefault(); e.stopPropagation(); }
    var m = maxScroll();
    if(m <= 0) return;
    if(viewport.scrollLeft <= 6) viewport.scrollTo({ left: m, behavior: "smooth" });
    else viewport.scrollBy({ left: -stepPx(), behavior: "smooth" });
  }
  prev.addEventListener("click", goPrev);
  next.addEventListener("click", goNext);
  window.addEventListener("resize", toggleArrows);
  toggleArrows();
})();`;
  simWrap.appendChild(sc);
}
}
```


