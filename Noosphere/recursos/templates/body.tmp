                    <div class="w-stat-item"><span class="w-stat-lbl">MIRA</span><span class="w-stat-val" id="w-mira-A-${uid}">0</span></div>
                    <div class="w-stat-item"><span class="w-stat-lbl">DIST</span><span class="w-stat-val" id="w-dist-A-${uid}">-</span></div>
                    <div class="w-stat-item"><span class="w-stat-lbl">DANO</span><span class="w-stat-val" id="w-dmg-A-${uid}">-</span></div>
